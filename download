:root {
  --background: #f7f8fc;
  --surface: #ffffff;
  --text: #1f2937;
  --muted: #667085;
  --primary: #2563eb;
  --primary-dark: #1d4ed8;
  --border: #e5e7eb;
  --max-width: 1080px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
    "Noto Sans TC", sans-serif;
  color: var(--text);
  background: var(--background);
  line-height: 1.7;
}

a {
  color: inherit;
}

.container {
  width: min(calc(100% - 40px), var(--max-width));
  margin: 0 auto;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(255, 255, 255, 0.94);
  border-bottom: 1px solid var(--border);
  backdrop-filter: blur(12px);
}

.nav-wrap {
  min-height: 68px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.brand {
  font-size: 1.2rem;
  font-weight: 800;
  text-decoration: none;
}

nav {
  display: flex;
  gap: 22px;
}

nav a {
  color: var(--muted);
  text-decoration: none;
  font-weight: 600;
}

nav a:hover {
  color: var(--primary);
}

.hero {
  padding: 110px 0 90px;
  background:
    radial-gradient(circle at 80% 20%, rgba(37, 99, 235, 0.18), transparent 30%),
    linear-gradient(180deg, #ffffff 0%, #f7f8fc 100%);
}

.hero-content {
  max-width: 760px;
}

.eyebrow {
  margin: 0 0 12px;
  color: var(--primary);
  font-size: 0.82rem;
  font-weight: 800;
  letter-spacing: 0.14em;
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h1 {
  margin-bottom: 22px;
  font-size: clamp(2.3rem, 6vw, 4.4rem);
  line-height: 1.12;
  letter-spacing: -0.04em;
}

h2 {
  margin-bottom: 12px;
  font-size: clamp(1.8rem, 4vw, 2.7rem);
  line-height: 1.2;
}

h3 {
  margin-bottom: 12px;
  font-size: 1.3rem;
  line-height: 1.4;
}

.hero-text {
  max-width: 650px;
  margin-bottom: 30px;
  color: var(--muted);
  font-size: 1.1rem;
}

.button {
  display: inline-block;
  padding: 12px 22px;
  border-radius: 10px;
  color: #ffffff;
  background: var(--primary);
  font-weight: 800;
  text-decoration: none;
  box-shadow: 0 10px 24px rgba(37, 99, 235, 0.22);
}

.button:hover {
  background: var(--primary-dark);
}

.section {
  padding: 80px 0;
}

.section-alt {
  background: #eef3ff;
}

.section-heading {
  margin-bottom: 30px;
}

.card-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
}

.card {
  padding: 28px;
  border: 1px solid var(--border);
  border-radius: 18px;
  background: var(--surface);
  box-shadow: 0 12px 32px rgba(15, 23, 42, 0.06);
}

.card p {
  color: var(--muted);
}

.card-meta {
  margin-bottom: 14px;
  font-size: 0.88rem;
}

.text-link {
  color: var(--primary);
  font-weight: 800;
  text-decoration: none;
}

.about {
  display: grid;
  grid-template-columns: minmax(220px, 0.8fr) minmax(300px, 1.2fr);
  gap: 50px;
  align-items: start;
}

.about > p {
  color: var(--muted);
  font-size: 1.08rem;
}

footer {
  padding: 26px 0;
  border-top: 1px solid var(--border);
  background: var(--surface);
}

.footer-content {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  color: var(--muted);
  font-size: 0.92rem;
}

.footer-content p {
  margin-bottom: 0;
}

@media (max-width: 800px) {
  .card-grid,
  .about {
    grid-template-columns: 1fr;
  }

  .hero {
    padding: 80px 0 70px;
  }
}

@media (max-width: 560px) {
  .nav-wrap {
    align-items: flex-start;
    flex-direction: column;
    padding: 16px 0;
  }

  nav {
    width: 100%;
    justify-content: space-between;
    gap: 12px;
  }

  .footer-content {
    flex-direction: column;
    gap: 6px;
  }
}
